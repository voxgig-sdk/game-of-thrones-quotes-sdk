# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 7
  metrics: count: method: 7

  entity: author: {
    path: "/author/{character}/{count}": {
      op: list: method: *GET
    }
  }

  entity: character: {
    path: "/character/{character}": {
      rename: param: "character": *"id"
      op: load: method: *GET
    }
    path: "/characters": {
      op: list: method: *GET
    }
  }

  entity: hous: {
    path: "/houses": {
      op: list: method: *GET
    }
  }

  entity: houses: {
    path: "/house/{house}": {
      rename: param: "house": *"id"
      op: load: method: *GET
    }
  }

  entity: random: {
    path: "/random": {
      op: load: method: *GET
    }
    path: "/random/{count}": {
      rename: param: "count": *"id"
      op: load: method: *GET
    }
  }

}