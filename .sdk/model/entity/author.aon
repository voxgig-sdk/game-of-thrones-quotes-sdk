# Entity: author

main: kit: entity: author: {

  alias: field: {}

  fields: [
    {
      name: "character"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "sentence"
      req: false
      short: "The quote text"
      type: "`$STRING`"
    }
  ]

  name: "author"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "tyrion"
                kind: "param"
                name: "character"
                orig: "character"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 2
                kind: "param"
                name: "count"
                orig: "count"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/author/{character}/{count}"
          parts: [
            "author"
            "{character}"
            "{count}"
          ]
          select: {
            exist: [
              "character"
              "count"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "author"
      ]
    ]
  }



}
