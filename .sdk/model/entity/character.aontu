# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: {
    house: {
      h: "House"
      n: "house"
      r: false
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Full name of the character"
      t: "`$STRING`"
    }
    quotes: {
      h: "Quotes"
      n: "quotes"
      r: false
      sh: "Quotes by this character"
      t: "`$ARRAY`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      sh: "URL-friendly identifier for the character"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /characters"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/characters"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "characters"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /character/{character}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "jon"
                k: "param"
                n: "id"
                or: "character"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/character/{character}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              character: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "character"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
