      points: [
        {
          contract: {
            id: "GET /houses"
            json: "{\"operationId\":\"getHouses\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"properties\":{\"members\":{\"description\":\"Members belonging to this house\",\"items\":{\"properties\":{\"name\":{\"description\":\"Full name of the character\",\"type\":\"string\"},\"slug\":{\"description\":\"URL-friendly identifier for the character\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Full name of the house\",\"type\":\"string\"},\"slug\":{\"description\":\"URL-friendly identifier for the house\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"List of houses with members\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
