# Entity: house

main: kit: entity: house: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    members: {
      h: "Members"
      n: "members"
      r: false
      sh: "Members belonging to this house"
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Full name of the house"
      t: "`$STRING`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: false
      sh: "URL-friendly identifier for the house"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "house"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /houses"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/houses"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "houses"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /house/{house}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "lannister"
                k: "param"
                n: "id"
                or: "house"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/house/{house}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              house: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "house"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
