# Entity: character

main: kit: entity: character: {

  alias: field: {}

  fields: [
    {
      name: "house"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Full name of the character"
      type: "`$STRING`"
    }
    {
      name: "quotes"
      req: false
      short: "Quotes by this character"
      type: "`$ARRAY`"
    }
    {
      name: "slug"
      req: false
      short: "URL-friendly identifier for the character"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /characters"
            json: "{\"operationId\":\"getCharacters\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"properties\":{\"house\":{\"properties\":{\"name\":{\"description\":\"Full name of the house\",\"type\":\"string\"},\"slug\":{\"description\":\"URL-friendly identifier for the house\",\"type\":\"string\"}},\"type\":\"object\"},\"name\":{\"description\":\"Full name of the character\",\"type\":\"string\"},\"quotes\":{\"description\":\"Quotes by this character\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"slug\":{\"description\":\"URL-friendly identifier for the character\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"List of characters with quotes\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/characters"
          segments: [
            {
              lit: "characters"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "jon"
                kind: "param"
                name: "id"
                orig: "character"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /character/{character}"
            json: "{\"operationId\":\"getCharacterDetails\",\"parameters\":[{\"description\":\"Slug or name of the character\",\"in\":\"path\",\"name\":\"character\",\"required\":true,\"schema\":{\"example\":\"jon\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"house\":{\"name\":\"House Stark of Winterfell\",\"slug\":\"stark\"},\"name\":\"Jon Snow\",\"quotes\":[\"If I fall, don't bring me back.\"],\"slug\":\"jon\"},\"schema\":{\"properties\":{\"house\":{\"properties\":{\"name\":{\"description\":\"Full name of the house\",\"type\":\"string\"},\"slug\":{\"description\":\"URL-friendly identifier for the house\",\"type\":\"string\"}},\"type\":\"object\"},\"name\":{\"description\":\"Full name of the character\",\"type\":\"string\"},\"quotes\":{\"description\":\"Quotes by this character\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"slug\":{\"description\":\"URL-friendly identifier for the character\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Details of the specified character with quotes\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/character/{character}"
          rename: {
            param: {
              character: "id"
            }
          }
          segments: [
            {
              lit: "character"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
