# Entity: random

main: kit: entity: random: {

  alias: field: {}

  fields: [
    {
      name: "character"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Full name of the character"
      type: "`$STRING`"
    }
    {
      name: "sentence"
      req: false
      short: "The quote text"
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: false
      short: "URL-friendly identifier for the character"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "random"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 5
                kind: "param"
                name: "id"
                orig: "count"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/random/{count}"
          parts: [
            "random"
            "{id}"
          ]
          rename: {
            param: {
              count: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/random"
          parts: [
            "random"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.character`"
          }
        }
      ]
    }
  }



}
