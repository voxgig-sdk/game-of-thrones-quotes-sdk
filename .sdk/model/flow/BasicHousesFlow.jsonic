# BasicHousesFlow

main: kit: flow: BasicHousesFlow:
{
  entity: "houses",
  kind: "basic",
  name: "BasicHousesFlow",
  step: [
    {
      input: {
        ref: "houses_ref01",
        srcdatavar: "houses_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "houses01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-houses_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHousesFlow"
}